"use client";

import { useEffect, useMemo, useState } from "react";

type Candidate = {
  id: string;
  name: string;
  email: string;
  area: string;
  attachment: any[];
  date: string;
  status: string;

  score: number | null;
  recommendation: string;
  summary: string;
  strength: string;
  gap: string;
  experience: string;

  seniority: string;
  languageFit: string;
  locationTimezoneFit: string;
  salaryRateFit: string;

  skillsMatch: string;
  experienceMatch: string;
  seniorityMatch: string;

  risks: string;
  redFlags: string;
  missingInformation: string;
  interviewQuestions: string;

  resumeText: string;
};

export default function DashboardPage() {
  const [candidates, setCandidates] = useState<Candidate[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [selected, setSelected] = useState<Candidate | null>(null);

  async function loadCandidates() {
    try {
      setLoading(true);
      setError("");

      const response = await fetch("/api/candidates", {
        cache: "no-store",
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || "Unable to load candidates.");
      }

      setCandidates(data.candidates || []);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to load candidates."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadCandidates();
  }, []);

  const stats = useMemo(() => {
    const scored = candidates.filter(
      (candidate) =>
        typeof candidate.score === "number"
    );

    const average =
      scored.length > 0
        ? scored.reduce(
            (sum, candidate) =>
              sum + Number(candidate.score),
            0
          ) / scored.length
        : null;

    const shortlisted = candidates.filter((candidate) => {
      const recommendation =
        candidate.recommendation.toLowerCase();

      return (
        recommendation.includes("yes") ||
        recommendation.includes("shortlist")
      );
    }).length;

    const underReview = candidates.filter((candidate) => {
      const recommendation =
        candidate.recommendation.toLowerCase();

      return (
        recommendation.includes("maybe") ||
        recommendation.includes("review")
      );
    }).length;

    return {
      total: candidates.length,
      scored: scored.length,
      average,
      shortlisted,
      underReview,
    };
  }, [candidates]);

  function scoreClass(score: number | null) {
    if (score === null) return "bg-slate-100 text-slate-600";
    if (score >= 8) return "bg-green-100 text-green-700";
    if (score >= 6) return "bg-amber-100 text-amber-700";
    return "bg-red-100 text-red-700";
  }

  function recommendationClass(value: string) {
    const text = value.toLowerCase();

    if (text.includes("yes") || text.includes("shortlist")) {
      return "bg-green-100 text-green-700";
    }

    if (text.includes("maybe") || text.includes("review")) {
      return "bg-amber-100 text-amber-700";
    }

    if (text.includes("reject")) {
      return "bg-red-100 text-red-700";
    }

    return "bg-slate-100 text-slate-600";
  }

  return (
    <main className="min-h-screen bg-[#f5f7fb] px-6 py-10 text-[#102047]">
      <div className="mx-auto max-w-7xl">
        <div className="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <p className="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-blue-600">
              Recruitment
            </p>

            <h1 className="text-4xl font-bold tracking-tight">
              Recruiter Dashboard
            </h1>

            <p className="mt-2 text-slate-500">
              Review candidate applications and ATS evaluation results.
            </p>
          </div>

          <div className="flex gap-3">
            <a
              href="/"
              className="rounded-xl border border-slate-200 bg-white px-5 py-3 font-semibold text-blue-600 shadow-sm hover:bg-slate-50"
            >
              Candidate application →
            </a>

            <button
              onClick={loadCandidates}
              className="rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-700"
            >
              Refresh
            </button>
          </div>
        </div>

        {error && (
          <div className="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
            <strong>Error:</strong> {error}
          </div>
        )}

        <div className="mb-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <StatCard
            title="Total candidates"
            value={stats.total}
          />

          <StatCard
            title="Under review"
            value={stats.underReview}
          />

          <StatCard
            title="Shortlisted"
            value={stats.shortlisted}
          />

          <StatCard
            title="Average ATS score"
            value={
              stats.average === null
                ? "—"
                : stats.average.toFixed(1)
            }
          />
        </div>

        <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div className="border-b border-slate-200 px-6 py-5">
            <h2 className="text-xl font-bold">
              Candidates
            </h2>

            <p className="mt-1 text-sm text-slate-500">
              Live data from Airtable.
            </p>
          </div>

          {loading ? (
            <div className="px-6 py-16 text-center text-slate-500">
              Loading candidates from Airtable...
            </div>
          ) : candidates.length === 0 ? (
            <div className="px-6 py-16 text-center">
              <p className="text-lg font-semibold">
                No candidates yet
              </p>
              <p className="mt-2 text-slate-500">
                Candidate submissions will appear here after they are
                processed.
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[1100px]">
                <thead className="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th className="px-6 py-4">Candidate</th>
                    <th className="px-6 py-4">Area</th>
                    <th className="px-6 py-4">ATS Score</th>
                    <th className="px-6 py-4">Recommendation</th>
                    <th className="px-6 py-4">Experience</th>
                    <th className="px-6 py-4">Summary</th>
                    <th className="px-6 py-4"></th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {candidates.map((candidate) => (
                    <tr
                      key={candidate.id}
                      className="hover:bg-slate-50"
                    >
                      <td className="px-6 py-5">
                        <div className="font-semibold">
                          {candidate.name || "Unnamed"}
                        </div>

                        <div className="mt-1 text-sm text-slate-500">
                          {candidate.email || "No email"}
                        </div>
                      </td>

                      <td className="px-6 py-5">
                        {candidate.area || "—"}
                      </td>

                      <td className="px-6 py-5">
                        <span
                          className={`rounded-full px-3 py-1 text-sm font-bold ${scoreClass(
                            candidate.score
                          )}`}
                        >
                          {candidate.score ?? "—"}
                        </span>
                      </td>

                      <td className="px-6 py-5">
                        <span
                          className={`rounded-full px-3 py-1 text-sm font-semibold ${recommendationClass(
                            candidate.recommendation
                          )}`}
                        >
                          {candidate.recommendation || "Pending"}
                        </span>
                      </td>

                      <td className="max-w-[220px] px-6 py-5">
                        <p className="line-clamp-2 text-sm text-slate-600">
                          {candidate.experience || "—"}
                        </p>
                      </td>

                      <td className="max-w-[300px] px-6 py-5">
                        <p className="line-clamp-2 text-sm text-slate-600">
                          {candidate.summary || "ATS report pending"}
                        </p>
                      </td>

                      <td className="px-6 py-5">
                        <button
                          onClick={() => setSelected(candidate)}
                          className="whitespace-nowrap rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-blue-600 hover:bg-blue-50"
                        >
                          View report
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>

      {selected && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-black/40 p-4">
          <div className="mx-auto my-8 max-w-4xl rounded-2xl bg-white shadow-2xl">
            <div className="flex items-start justify-between border-b border-slate-200 p-6">
              <div>
                <h2 className="text-2xl font-bold">
                  {selected.name}
                </h2>

                <p className="mt-1 text-slate-500">
                  {selected.email}
                </p>
              </div>

              <button
                onClick={() => setSelected(null)}
                className="rounded-lg px-3 py-2 text-xl text-slate-500 hover:bg-slate-100"
              >
                ×
              </button>
            </div>

            <div className="grid gap-5 p-6 md:grid-cols-3">
              <ReportCard
                title="ATS Score"
                value={
                  selected.score === null
                    ? "Pending"
                    : String(selected.score)
                }
              />

              <ReportCard
                title="Recommendation"
                value={
                  selected.recommendation || "Pending"
                }
              />

              <ReportCard
                title="Area"
                value={selected.area || "—"}
              />
            </div>

            <div className="space-y-6 px-6 pb-8">
              <ReportSection
                title="Summary"
                value={selected.summary}
              />

              <ReportSection
                title="Strengths"
                value={selected.strength}
              />

              <ReportSection
                title="Gaps"
                value={selected.gap}
              />

              <ReportSection
                title="Experience"
                value={selected.experience}
              />

              <ReportSection
                title="Skills Match"
                value={selected.skillsMatch}
              />

              <ReportSection
                title="Experience Match"
                value={selected.experienceMatch}
              />

              <ReportSection
                title="Seniority Match"
                value={selected.seniorityMatch}
              />

              <ReportSection
                title="Risks"
                value={selected.risks}
              />

              <ReportSection
                title="Red Flags"
                value={selected.redFlags}
              />

              <ReportSection
                title="Missing Information"
                value={selected.missingInformation}
              />

              <ReportSection
                title="Suggested Interview Questions"
                value={selected.interviewQuestions}
              />
            </div>
          </div>
        </div>
      )}
    </main>
  );
}

function StatCard({
  title,
  value,
}: {
  title: string;
  value: string | number;
}) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p className="text-sm font-medium text-slate-500">
        {title}
      </p>

      <p className="mt-3 text-4xl font-bold">
        {value}
      </p>
    </div>
  );
}

function ReportCard({
  title,
  value,
}: {
  title: string;
  value: string;
}) {
  return (
    <div className="rounded-xl bg-slate-50 p-5">
      <p className="text-sm text-slate-500">
        {title}
      </p>

      <p className="mt-2 font-bold">
        {value}
      </p>
    </div>
  );
}

function ReportSection({
  title,
  value,
}: {
  title: string;
  value: string;
}) {
  if (!value) return null;

  return (
    <section>
      <h3 className="mb-2 text-lg font-bold">
        {title}
      </h3>

      <div className="whitespace-pre-wrap rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-700">
        {value}
      </div>
    </section>
  );
}
