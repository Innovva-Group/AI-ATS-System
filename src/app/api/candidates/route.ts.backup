import { NextResponse } from "next/server";

export const runtime = "nodejs";

const CANDIDATE_TABLE = "Candidates Data From Dashboard";
const ATS_TABLE = "Status Update";

const ATTACHMENT_FIELD_NAME = "Attachment";

const N8N_WEBHOOK_URL =
  "https://n8n.domingogarcia.info/webhook/a91cd0c0-7a4b-498a-b186-a7785f52eff1";

async function getAirtableRecords(tableName: string) {
  const token = process.env.AIRTABLE_TOKEN;
  const baseId = process.env.AIRTABLE_BASE_ID;

  if (!token || !baseId) {
    throw new Error("Airtable configuration is missing.");
  }

  const table = encodeURIComponent(tableName);

  const response = await fetch(
    `https://api.airtable.com/v0/${baseId}/${table}`,
    {
      headers: {
        Authorization: `Bearer ${token}`,
      },
      cache: "no-store",
    }
  );

  const data = await response.json();

  if (!response.ok) {
    console.error("Airtable fetch failed:", data);
    throw new Error(
      data?.error?.message || "Unable to fetch Airtable records."
    );
  }

  return data.records || [];
}

/*
 * GET
 * Used by recruiter dashboard.
 */
export async function GET() {
  try {
    const candidateRecords = await getAirtableRecords(CANDIDATE_TABLE);
    const atsRecords = await getAirtableRecords(ATS_TABLE);

    const atsByName = new Map<string, any>();

    for (const record of atsRecords) {
      const fields = record.fields || {};
      const name = String(fields.Name || "").trim().toLowerCase();

      if (name) {
        atsByName.set(name, {
          id: record.id,
          ...fields,
        });
      }
    }

    const candidates = candidateRecords.map((record: any) => {
      const fields = record.fields || {};

      const name = String(fields.Name || "").trim();
      const ats = atsByName.get(name.toLowerCase()) || {};

      return {
        id: record.id,

        // Candidate information
        name,
        email: fields.Email || "",
        area: fields.Area || ats.Area || "",
        attachment: fields.Attachment || [],
        date: fields.Date || record.createdTime || "",
        status: fields.Status || "",

        // ATS information
        score: ats.Score ?? null,
        recommendation: ats.Recommendation || "",
        summary: ats.Summary || "",

        strength:
          ats.Strength ||
          ats.Strengths ||
          "",

        gap:
          ats.Gap ||
          ats.Gaps ||
          "",

        experience: ats.Experience || "",

        seniority: ats.Seniority || "",
        languageFit: ats["Language Fit"] || "",
        locationTimezoneFit: ats["Location/Timezone Fit"] || "",
        salaryRateFit: ats["Salary/Rate Fit"] || "",

        skillsMatch: ats["Skills Match"] || "",
        experienceMatch: ats["Experience Match"] || "",
        seniorityMatch: ats["Seniority Match"] || "",

        risks: ats.Risks || "",
        redFlags: ats["Red Flags"] || "",
        missingInformation: ats["Missing Information"] || "",

        interviewQuestions:
          ats["Suggested Interview Questions"] ||
          ats["Interview Questions"] ||
          "",

        resumeText: fields["Resume Text"] || "",
      };
    });

    return NextResponse.json({
      success: true,
      candidates,
    });
  } catch (error) {
    console.error("Dashboard API error:", error);

    return NextResponse.json(
      {
        success: false,
        error:
          error instanceof Error
            ? error.message
            : "Unable to load candidates.",
      },
      { status: 500 }
    );
  }
}

/*
 * POST
 * Candidate application submission.
 */
export async function POST(request: Request) {
  try {
    const formData = await request.formData();

    const name = formData.get("name");
    const email = formData.get("email");
    const area = formData.get("area");
    const cv = formData.get("cv");

    if (typeof name !== "string" || !name.trim()) {
      return NextResponse.json(
        { success: false, error: "Name is required." },
        { status: 400 }
      );
    }

    if (typeof email !== "string" || !email.trim()) {
      return NextResponse.json(
        { success: false, error: "Email is required." },
        { status: 400 }
      );
    }

    if (!(cv instanceof File)) {
      return NextResponse.json(
        { success: false, error: "CV is required." },
        { status: 400 }
      );
    }

    const token = process.env.AIRTABLE_TOKEN;
    const baseId = process.env.AIRTABLE_BASE_ID;

    if (!token || !baseId) {
      console.error("Missing Airtable environment variables.");

      return NextResponse.json(
        {
          success: false,
          error: "Airtable configuration is missing.",
        },
        { status: 500 }
      );
    }

    const table = encodeURIComponent(ATS_TABLE);

    const createResponse = await fetch(
      `https://api.airtable.com/v0/${baseId}/${table}`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          fields: {
            Name: name.trim(),
            Email: email.trim(),
            Area: typeof area === "string" ? area.trim() : "",
          },
        }),
      }
    );

    const createData = await createResponse.json();

    if (!createResponse.ok) {
      console.error("Airtable record creation failed:", createData);

      return NextResponse.json(
        {
          success: false,
          error:
            createData?.error?.message ||
            "Could not create the Airtable record.",
        },
        { status: 500 }
      );
    }

    const recordId = createData.id;

    const cvBuffer = Buffer.from(await cv.arrayBuffer());
    const cvBase64 = cvBuffer.toString("base64");

    const attachmentField = encodeURIComponent(ATTACHMENT_FIELD_NAME);

    const uploadUrl =
      `https://content.airtable.com/v0/${baseId}/${recordId}/${attachmentField}/uploadAttachment`;

    const uploadResponse = await fetch(uploadUrl, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        contentType: cv.type || "application/octet-stream",
        filename: cv.name,
        file: cvBase64,
      }),
    });

    const uploadData = await uploadResponse.json();

    if (!uploadResponse.ok) {
      console.error("Airtable CV upload failed:", uploadData);

      return NextResponse.json(
        {
          success: false,
          error:
            uploadData?.error?.message ||
            "The candidate was created, but the CV upload failed.",
          recordId,
        },
        { status: 500 }
      );
    }

    try {
      const n8nFormData = new FormData();

      n8nFormData.append("name", name.trim());
      n8nFormData.append("email", email.trim());
      n8nFormData.append(
        "area",
        typeof area === "string" ? area.trim() : ""
      );

      const n8nFile = new File(
        [cvBuffer],
        cv.name,
        {
          type: cv.type || "application/octet-stream",
        }
      );

      n8nFormData.append("cv", n8nFile);
      n8nFormData.append("airtableRecordId", recordId);

      const n8nResponse = await fetch(N8N_WEBHOOK_URL, {
        method: "POST",
        body: n8nFormData,
      });

      const n8nText = await n8nResponse.text();

      if (!n8nResponse.ok) {
        console.error(
          "n8n webhook failed:",
          n8nResponse.status,
          n8nText
        );
      } else {
        console.log("n8n webhook successfully triggered.");
      }
    } catch (n8nError) {
      console.error("n8n webhook connection failed:", n8nError);
    }

    return NextResponse.json({
      success: true,
      message: "Application submitted successfully.",
      recordId,
    });
  } catch (error) {
    console.error("Candidate API error:", error);

    return NextResponse.json(
      {
        success: false,
        error: "Unable to submit application. Please try again.",
      },
      { status: 500 }
    );
  }
}
